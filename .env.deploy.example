# Скопируйте в .env.deploy (он в .gitignore) и заполните.

# Адрес сайта: печатается после заливки и нужен plan-pull.sh / plan-push.sh.
DEPLOY_URL=https://plan.example.com

# Способ заливки: ssh (rsync по SSH) или ftp (lftp mirror).
DEPLOY_METHOD=ssh

# SSH: user@host или алиас из ~/.ssh/config; путь к корню сайта на сервере.
DEPLOY_SSH=user@example.com
DEPLOY_PATH=www/plan.example.com
# Доп. опции ssh, например порт или ключ:
# DEPLOY_SSH_OPTS="-p 2222 -i ~/.ssh/id_ed25519"

# FTP (если DEPLOY_METHOD=ftp):
# FTP_HOST=ftp.example.com
# FTP_USER=
# FTP_PASSWORD=
# FTP_PATH=www/plan.example.com
# FTP_SSL_VERIFY=yes

# Пароль планировщика для plan-pull.sh / plan-push.sh (тот, что задан в api/setup.php).
# HOUSE_URL по умолчанию равен DEPLOY_URL.
# HOUSE_PASSWORD=

# Пример: Beget (виртуальный хостинг с Apache и SSH).
# DEPLOY_SSH=<логин>@<логин>.beget.tech
# DEPLOY_PATH=<домен>/public_html
# Хранилище мастер установки создаст в <домен>/storage — вне корня сайта.
# По FTP: FTP_HOST=<логин>.beget.tech, FTP_PATH=<домен>/public_html, пользователь FTP из панели.
